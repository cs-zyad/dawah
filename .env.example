# ═══════════════ وفدة | WAFDA — متغيرات البيئة ═══════════════
# انسخ هذا الملف إلى .env.local للتطوير، أو أضف القيم في Vercel → Settings → Environment Variables.

# ── قاعدة البيانات (إلزامي في الإنتاج) ──
# محتوى ملف حساب خدمة Firebase كاملًا (JSON في سطر واحد) أو بترميز base64.
# ⚠ سرّي: لا ترفع الملف أو القيمة على GitHub أبدًا.
FIREBASE_SERVICE_ACCOUNT=

# بديل للتطوير: محاكي Firestore المحلي (يضبطه npm run dev:local تلقائيًا)
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# ── الوضع التجريبي ──
# true: يفعّل صندوق الرسائل التجريبي (/dev/inbox) وصفحة الدفع التجريبية (/dev/checkout)
#       ويعبّئ البيانات التجريبية مرة واحدة عند البناء.
# false: الإنتاج الحقيقي (يعطّل الصفحتين التجريبيتين).
DEMO_MODE=true

# ── الدفع ──
# سر توقيع إشعارات الدفع (HMAC-SHA256)؛ 16 حرفًا عشوائيًا على الأقل.
# لتوليده: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=

# ── المهام المجدولة ──
# Vercel Cron يرسل Authorization: Bearer CRON_SECRET إلى /api/cron
CRON_SECRET=

# ── رابط المنصة (اختياري) ──
# يُستنتج تلقائيًا من VERCEL_PROJECT_PRODUCTION_URL على Vercel، أو http://localhost:3000 محليًا.
# APP_URL=https://wafda.example.com

# ── متقدّم (اختياري) ──
# DISABLE_INPROCESS_WORKER=true   # يعطّل عامل المهام داخل خادم Next (استخدم npm run worker بدلًا منه)
